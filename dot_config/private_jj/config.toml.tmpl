"$schema" = "https://jj-vcs.github.io/jj/latest/config-schema.json"

[user]
name = "Travis Lyons"
email = "{{ .email.primary }}"

{{- if eq .profile "work"}}
[[--scope]]
--when.repositories = ["~/src/github.com/trly"]

[--scope.user]
email = "{{ .email.secondary }}"
{{- end }}

[signing]
behavior = "own"
backend = "ssh"
{{- if eq .profile "work"}}
key = "{{ onepasswordRead "op://Employee/ibtmymhhjxy5ofqryhgw2x7yvi/public key" }}"
{{- end }}
{{- if eq .profile "personal"}}
key = "{{ onepasswordRead "op://Private/2slqk64ohaylxylevbp4oeztae/public key" }}"
{{- end }}

[signing.backends.ssh]
allowed-signers = "~/.ssh/allowed_signers"
{{- if eq .chezmoi.os "darwin" }}
program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
{{- else }}
program = "/opt/1Password/op-ssh-sign"
{{- end }}

[ui]
pager = "delta"
diff-formatter = ":git"
default-command = "log"

[aliases]
push-with-checks = ["util", "exec", "--", "bash", "-c", """
set -euo pipefail
eval "$(mise activate bash)"
read to_ref from_ref < <(
  jj log -r 'remote_bookmarks(remote=origin)-..bookmarks()' --no-graph -T 'commit_id ++ "\n"' \
    | awk 'NR==1 {first=$0} {last=$0} END {print first, last}'
)
if [ -z "$to_ref" ]; then
  echo "Nothing to push."
  exit 0
fi
pre-commit run --from-ref "$from_ref" --to-ref "$to_ref"
jj git push "$@"
""", ""]

