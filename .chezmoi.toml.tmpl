{{- $email := promptStringOnce . "email" "Email address" -}}
{{- $profileChoices := list "work" "personal" -}}
{{- $profile := promptChoiceOnce . "profile" "What configuration profile should be used" -}}

[data]
    email = {{ $email | quote }}
    profile = {{ $profile | quote }}

[edit]
    command = "nvim"

[git]
    autoCommit = true
    autoPush = true

[diff]
  pager = "delta"

[merge]
  command = "nvim"
  args = ["-d", "{{ `{{` }} .Source }}", "{{ `{{` }} .Destination }}", "{{ `{{` }} .Target }}"]

