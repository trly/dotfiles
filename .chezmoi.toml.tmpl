{{- $email := promptStringOnce . "email" "Email address" -}}
{{- $profile := promptStringOnce . "profile" "chezmoi profile" -}}

[data]
    email = {{ $email | quote }}
    profile = {{ $profile | quote }}

[git]
    autoCommit = true
    autoPush = true

[diff]
    pager = "diff-so-fancy"

[merge]
  command = "nvim"
  args = ["-d", "{{ `{{` }} .Source }}", "{{ `{{` }} .Destination }}", "{{ `{{` }} .Target }}"]

