#### BEGIN USER CONFIGURATION ####
export ZSH="$HOME/.zsh"
export PATH="$HOME/bin:$HOME/.local/bin:$PATH"
export HISTFILE=$ZSH/zsh_history
export HISTSIZE=10000
export SAVEHIST=10000
setopt HIST_IGNORE_DUPS
setopt HIST_FIND_NO_DUPS

zle -N menu-search
zle -N recent-paths

source $ZSH/antidote/antidote.zsh
antidote load $ZSH/zsh_plugins.txt

bindkey '\t\t' autosuggest-accept

if command -v nvim &> /dev/null; then
  export EDITOR="nvim"
  export VISUAL="nvim"
  alias vi=nvim
  alias vim=nvim
fi

if command -v atuin &> /dev/null; then
  eval "$(atuin init zsh)"
fi

if command -v lazygit &> /dev/null; then
  alias lg=lazygit
fi

{{- if eq .profile "home"}}
#### BEGIN HOME PROFILE ####
export AMP_API_KEY={{ onepasswordRead "op://Private/Amp API Key/credential" }}
export SSH_AUTH_SOCK=~/.1password/agent.sock
{{- if eq .chezmoi.osRelease.id "arch"}}
export PATH=".local/share/JetBrains/Toolbox/scripts:$PATH"
{{- end }}
#### END HOME PROFILE ####
{{- end }}

{{- if eq .profile "work"}}
#### BEGIN WORK PROFILE ####
export AMP_API_KEY={{ onepasswordRead "op://Employee/Amp API Key/credential" }}
export ANTHROPIC_API_KEY={{ onepasswordRead "op://Employee/y5mvlflkapp7sqkm5brdfryvie/credential"}}
export SRC_ACCESS_TOKEN={{ onepasswordRead "op://Employee/demo.sourcegraph.com API Token/password" }}
export SRC_ENDPOINT={{ onepasswordRead "op://Employee/demo.sourcegraph.com API Token/website" }}
export SRC_BATCH_TMP_DIR=$HOME/.batch_change_tmp
export PATH="$HOME/Library/Application Support/JetBrains/Toolbox/scripts/:$PATH"
export SSH_AUTH_SOCK="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
export GITHUB_TOKEN={{ onepasswordRead "op://Employee/tic2vdlxonqobta22kzv6c4f24/credential" }}

sg_results_extract_repos() {
  jq -r '[.Results[].repository.name] | unique | .[] | sub("^github.com/"; "")'
}

dotcom_search() {
  SRC_ACCESS_TOKEN={{ onepasswordRead "op://Employee/bjqo4ayroswpj5vtamocynmtmq/credential" }} \
  SRC_ENDPOINT={{ onepasswordRead "op://Employee/bjqo4ayroswpj5vtamocynmtmq/url" }} \
  src search -- "$@"
}

dotcom_search_json() {
  SRC_ACCESS_TOKEN={{ onepasswordRead "op://Employee/bjqo4ayroswpj5vtamocynmtmq/credential" }} \
  SRC_ENDPOINT={{ onepasswordRead "op://Employee/bjqo4ayroswpj5vtamocynmtmq/url" }} \
  src search -json "$@"
}

dotcom_get_repos() {
  dotcom_search_json "$@" | sg_results_extract_repos
}

#### END WORK PROFILE ####
{{- end }}

if command -v direnv &> /dev/null; then
  eval "$(direnv hook zsh)"
fi
#### END USER CONFIGURATION ####
