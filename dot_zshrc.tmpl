export ZSH="$HOME/.oh-my-zsh"
export DISABLE_AUTO_UPDATE=true
ZSH_THEME=""
EDITOR=nvim

{{- if eq .chezmoi.os "darwin" }}
plugins=(
  colorize
  fast-syntax-highlighting
  fzf
  git
  mise
  ssh
  zsh-autocomplete
  zsh-autosuggestions
  zsh-syntax-highlighting
  direnv
  brew
  macos
)
{{ else }}
plugins=(
  colorize
  fast-syntax-highlighting
  fzf
  git
  mise
  ssh
  zsh-autocomplete
  zsh-autosuggestions
  zsh-syntax-highlighting
  direnv
)
{{- end }}
source $ZSH/oh-my-zsh.sh

#### BEGIN USER CONFIGURATION ####
alias vi=nvim
alias vim=nvim
alias lg=lazygit

export PATH="$HOME/.local/bin:$PATH"
export AMP_TOOLBOX="/Users/trly/.config/amp/tools"

if command -v atuin &> /dev/null; then
  eval "$(atuin init zsh)"
fi

if command -v mise &> /dev/null; then
  eval "$(mise activate zsh)"
fi

if command -v pwgen &> /dev/null; then
  function podman-secret() {
    local length=${1:-32}
    local name=$2
    local replace=${3:-false}
    
    if [[ -z "$name" ]]; then
      echo "Usage: podman-secret <length> <name> [replace]"
      return 1
    fi
    
    local replace_flag=""
    if [[ "$replace" == "true" ]]; then
      replace_flag="--replace"
    fi
    
    echo -n $(pwgen -1 "$length") | podman secret create "$name" $replace_flag -
  }
fi

