#### BEGIN USER CONFIGURATION ####
export ZSH="$HOME/.zsh"
export PATH="$HOME/bin:$HOME/.local/bin:$PATH"
export HISTFILE=$ZSH/zsh_history
export HISTSIZE=100000
export SAVEHIST=100000
setopt EXTENDED_HISTORY
setopt SHARE_HISTORY
setopt INC_APPEND_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_SAVE_NO_DUPS
setopt HIST_FIND_NO_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_REDUCE_BLANKS
setopt HIST_VERIFY

zle -N menu-search
zle -N recent-paths
zstyle ':omz:plugins:eza' 'git-status' yes
zstyle ':omz:plugins:eza' 'icons' yes
zstyle ':omz:plugins:eza' 'dirs-first' yes
zstyle ':antidote:bundle' file $ZSH/zsh_plugins.txt
zstyle ':antidote:static' file $ZSH/zsh_plugins.zsh

source $ZSH/antidote/antidote.zsh

# Global autocompletion paths — add directories to fpath if they exist.
# ez-compinit (loaded via antidote) calls compinit automatically.
typeset -a _completion_paths=(
  "$HOME/.docker/completions"
)
for _cp in "${_completion_paths[@]}"; do
  [[ -d "$_cp" ]] && fpath=("$_cp" $fpath)
done
unset _completion_paths _cp

antidote load

if command -v ngrok &> /dev/null; then
  eval "$(ngrok completion)"
fi

if command -v zellij &> /dev/null; then
  if [[ -z "$ZELLIJ" ]]; then
    if [[ "$ZELLIJ_AUTO_ATTACH" == "true" ]]; then
      zellij attach -c {{ .chezmoi.hostname }}
    else
      zellij
    fi

    if [[ "$ZELLIJ_AUTO_EXIT" == "true" ]]; then
     exit
    fi
  fi
fi

if command -v nvim &> /dev/null; then
  export EDITOR="nvim"
  export VISUAL="nvim"
  alias vi=nvim
  alias vim=nvim
fi

if command -v atuin &> /dev/null; then
  eval "$(atuin init zsh)"
fi

if command -v lazygit &> /dev/null; then
  alias lg=lazygit
fi

if command -v rustup &> /dev/null; then
  export PATH="$HOME/.cargo/bin:$PATH"
fi

{{- if eq .profile "personal"}}
#### BEGIN PERSONAL PROFILE ####
export AMP_API_KEY={{ onepasswordRead "op://Private/Amp API Key/credential" }}
export SSH_AUTH_SOCK="$HOME/.1password/agent.sock"
{{- if eq .chezmoi.osRelease.id "arch"}}
export PATH="$HOME/.local/share/JetBrains/Toolbox/scripts:$PATH"
{{- end }}
#### END PERSONAL PROFILE ####
{{- end }}

