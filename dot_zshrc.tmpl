#### BEGIN USER CONFIGURATION ####
export ZSH="$HOME/.oh-my-zsh"

export DISABLE_AUTO_UPDATE=true

ZSH_THEME=""

EDITOR=nvim

{{- if eq .chezmoi.os "darwin" }}
plugins=(
  colorize
  fast-syntax-highlighting
  fzf
  gh
  mise
  ssh
  zsh-autocomplete
  zsh-autosuggestions
  zsh-syntax-highlighting
  direnv
  brew
  macos
)
{{ else }}
plugins=(
  colorize
  fast-syntax-highlighting
  fzf
  mise
  ssh
  zsh-autocomplete
  zsh-autosuggestions
  zsh-syntax-highlighting
  direnv
)
{{- end }}

source $ZSH/oh-my-zsh.sh

if [[ -z "$ZELLIJ" ]]; then
    if [[ "$ZELLIJ_AUTO_ATTACH" == "true" ]]; then
        zellij attach -c
    else
        zellij
    fi

    if [[ "$ZELLIJ_AUTO_EXIT" == "true" ]]; then
        exit
    fi
fi

if command -v starship &> /dev/null; then
  eval "$(starship init zsh)"
fi

alias vi=nvim
alias vim=nvim
alias lg=lazygit
alias cat=bat
alias ls='eza -lh --group-directories-first --icons=auto'
alias lsa='ls -a'
alias lt='eza --tree --level=2 --long --icons --git'
alias lta='lt -a'
alias ff="fzf --preview 'bat --style=numbers --color=always {}'"

if command -v eza &> /dev/null; then
  alias ls='eza -lh --group-directories-first --icons=auto'
  alias lsa='ls -a'
  alias lt='eza --tree --level=2 --long --icons --git'
  alias lta='lt -a'
fi

export PATH="$HOME/.local/bin:$PATH"
export AMP_TOOLBOX="/Users/trly/.config/amp/tools"

if command -v atuin &> /dev/null; then
  eval "$(atuin init zsh)"
fi

if command -v mise &> /dev/null; then
  eval "$(mise activate zsh)"
fi

if command -v pwgen &> /dev/null; then
  function podman-secret() {
    local length=${1:-32}
    local name=$2
    local replace=${3:-false}
    
    if [[ -z "$name" ]]; then
      echo "Usage: podman-secret <length> <name> [replace]"
      return 1
    fi
    
    local replace_flag=""
    if [[ "$replace" == "true" ]]; then
      replace_flag="--replace"
    fi
    
    echo -n $(pwgen -1 "$length") | podman secret create "$name" $replace_flag -
  }
fi

# Transcode a video to a good-balance 1080p that's great for sharing online
transcode-video-1080p() {
  if [[ -z "$1" ]]; then
    echo "Usage: transcode-video-1080p <input_file>"
    return 1
  fi
  ffmpeg -i "$1" -vf scale=1920:1080 -c:v libx264 -preset fast -crf 23 -c:a copy "${1%.*}-1080p.mp4"
}

# Transcode a video to a good-balance 4K that's great for sharing online
transcode-video-4K() {
  if [[ -z "$1" ]]; then
    echo "Usage: transcode-video-4K <input_file>"
    return 1
  fi
  ffmpeg -i "$1" -c:v libx265 -preset slow -crf 24 -c:a aac -b:a 192k "${1%.*}-optimized.mp4"
}

