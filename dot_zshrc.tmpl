export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
COMPLETION_WAITING_DOTS="true"
export DISABLE_AUTO_UPDATE=true

{{ if eq .chezmoi.os "darwin" }}
plugins=(colorize fast-syntax-highlighting fzf git mise ssh zsh-autocomplete zsh-autosuggestions zsh-syntax-highlighting brew macos)
{{ else }}
plugins=(colorize fast-syntax-highlighting fzf git mise ssh zsh-autocomplete zsh-autosuggestions zsh-syntax-highlighting)
{{ end }}
source $ZSH/oh-my-zsh.sh

#### BEGIN USER CONFIGURATION ####
alias vi=nvim
alias vim=nvim


if command -v atuin &> /dev/null; then
  eval "$(atuin init zsh)"
fi

if command -v mise &> /dev/null; then
  eval "$(mise activate bash)"
fi

{{ if eq .profile "home"}}
#### BEGIN HOME PROFILE ####
export AMP_API_KEY={{ onepasswordRead "op://Private/Amp API Key/credential" }}
{{ if eq .chezmoi.osRelease.id "arch"}}
source ~/.local/share/omarchy/default/bash/aliases
source ~/.local/share/omarchy/default/bash/envs
source ~/.local/share/omarchy/default/bash/envs
source ~/.local/share/omarchy/default/bash/functions
{{ end }}
#### END HOME PROFILE ####
{{ end }}


{{ if eq .profile "work"}}
#### BEGIN WORK PROFILE ####
alias ls='eza -lh --group-directories-first --icons=auto'
alias lsa='ls -a'
alias lt='eza --tree --level=2 --long --icons --git'
alias lta='lt -a'
alias ff="fzf --preview 'bat --style=numbers --color=always {}'"
alias cd="zd"
zd() {
  if [ $# -eq 0 ]; then
    builtin cd ~ && return
  elif [ -d "$1" ]; then
    builtin cd "$1"
  else
    z "$@" && printf " \U000F17A9 " && pwd || echo "Error: Directory not found"
  fi
}
export AMP_API_KEY={{ onepasswordRead "op://Employee/Amp API Key/credential" }}
export SRC_ACCESS_TOKEN={{ onepasswordRead "op://Employee/demo.sourcegraph.com API Token/password" }}
export SRC_ENDPOINT={{ onepasswordRead "op://Employee/demo.sourcegraph.com API Token/website" }}

export SRC_BATCH_TMP_DIR=~/.batch_change_tmp
export PATH="/opt/homebrew/opt/postgresql@16/bin:$PATH"
export PATH="~/Library/Application\ Support/JetBrains/Toolbox/scripts/:$PATH"
autoload -Uz compinit && compinit
PROG=sg source /Users/trly/.sourcegraph/sg.zsh_autocomplete
source /Users/trly/google-cloud-sdk/completion.zsh.inc
source /Users/trly/google-cloud-sdk/path.zsh.inc
source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
#### END WORK PROFILE ####
{{ end }}

#### END USER CONFIGURATION ####
