export ZSH="$HOME/.oh-my-zsh"
export DISABLE_AUTO_UPDATE=true
ZSH_THEME=""

{{- if eq .chezmoi.os "darwin" }}
plugins=(
  colorize
  fast-syntax-highlighting
  fzf
  git
  mise
  ssh
  zsh-autocomplete
  zsh-autosuggestions
  zsh-syntax-highlighting
  direnv
  brew
  macos
)
{{ else }}
plugins=(
  colorize
  fast-syntax-highlighting
  fzf
  git
  mise
  ssh
  zsh-autocomplete
  zsh-autosuggestions
  zsh-syntax-highlighting
  direnv
)
{{- end }}
source $ZSH/oh-my-zsh.sh

#### BEGIN USER CONFIGURATION ####
alias vi=nvim
alias vim=nvim
alias lg=lazygit

export PATH="$HOME/.local/bin:$PATH"
export AMP_TOOLBOX="/Users/trly/.config/amp/tools"

if command -v atuin &> /dev/null; then
  eval "$(atuin init zsh)"
fi

if command -v mise &> /dev/null; then
  eval "$(mise activate zsh)"
fi

{{- if eq .profile "home"}}
#### BEGIN HOME PROFILE ####
export AMP_API_KEY={{ onepasswordRead "op://Private/Amp API Key/credential" }}
{{- if eq .chezmoi.osRelease.id "arch"}}
source ~/.local/share/omarchy/default/bash/aliases
source ~/.local/share/omarchy/default/bash/envs
source ~/.local/share/omarchy/default/bash/envs
source ~/.local/share/omarchy/default/bash/functions

export PATH=".local/share/JetBrains/Toolbox/scripts:$PATH"
{{- end }}
#### END HOME PROFILE ####
{{- end }}

{{- if eq .profile "work"}}
#### BEGIN WORK PROFILE ####
alias ls='eza -lh --group-directories-first --icons=auto'
alias lsa='ls -a'
alias lt='eza --tree --level=2 --long --icons --git'
alias lta='lt -a'
alias ff="fzf --preview 'bat --style=numbers --color=always {}'"
export AMP_API_KEY={{ onepasswordRead "op://Employee/Amp API Key/credential" }}
export AMP_CLIENT_ID={{ onepasswordRead "op://Shared/hbabu3rd7fedqd4zvowwx6vjim/username" }}
export AMP_CLIENT_SECRET={{ onepasswordRead "op://Shared/hbabu3rd7fedqd4zvowwx6vjim/password" }}
export SRC_ACCESS_TOKEN={{ onepasswordRead "op://Employee/demo.sourcegraph.com API Token/password" }}
export SRC_ENDPOINT={{ onepasswordRead "op://Employee/demo.sourcegraph.com API Token/website" }}
export SRC_BATCH_TMP_DIR=~/.batch_change_tmp
export PATH="~/Library/Application Support/JetBrains/Toolbox/scripts/:$PATH"
export SSH_AUTH_SOCK=~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock
#### END WORK PROFILE ####
{{- end }}

if command -v starship &> /dev/null; then
  eval "$(starship init zsh)"
fi
#### END USER CONFIGURATION ####

