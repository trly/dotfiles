#### BEGIN USER CONFIGURATION ####
export ZSH="$HOME/.zsh"
export PATH="$HOME/bin:$HOME/.local/bin:$PATH"
export HISTFILE=$ZSH/zsh_history
export HISTSIZE=10000
export SAVEHIST=10000
setopt HIST_IGNORE_DUPS
setopt HIST_FIND_NO_DUPS

source $ZSH/antidote/antidote.zsh
antidote load $ZSH/zsh_plugins.txt

bindkey '\t\t' autosuggest-accept

if command -v atuin &> /dev/null; then
  eval "$(atuin init zsh)"
fi

if command -v starship &> /dev/null; then
  eval "$(starship init zsh)"
fi

if command -v nvim &> /dev/null; then
  export EDITOR="nvim"
  export VISUAL="nvim"
  alias vi=nvim
  alias vim=nvim
fi

if command -v lazygit &> /dev/null; then
  alias lg=lazygit
fi

if command -v mise &> /dev/null; then
  eval "$(mise activate zsh)"
fi

if command -v pwgen &> /dev/null; then
  function podman-secret() {
    local length=${1:-32}
    local name=$2
    local replace=${3:-false}
    
    if [[ -z "$name" ]]; then
      echo "Usage: podman-secret <length> <name> [replace]"
      return 1
    fi
    
    local replace_flag=""
    if [[ "$replace" == "true" ]]; then
      replace_flag="--replace"
    fi
    
    echo -n $(pwgen -1 "$length") | podman secret create "$name" $replace_flag -
  }
fi

if command -v ffmpeg &> /dev/null; then
  # Transcode a video to a good-balance 1080p that's great for sharing online
  transcode-video-1080p() {
    if [[ -z "$1" ]]; then
      echo "Usage: transcode-video-1080p <input_file>"
      return 1
    fi
    ffmpeg -i "$1" -vf scale=1920:1080 -c:v libx264 -preset fast -crf 23 -c:a copy "${1%.*}-1080p.mp4"
  }

  # Transcode a video to a good-balance 4K that's great for sharing online
  transcode-video-4K() {
    if [[ -z "$1" ]]; then
      echo "Usage: transcode-video-4K <input_file>"
      return 1
    fi
    ffmpeg -i "$1" -c:v libx265 -preset slow -crf 24 -c:a aac -b:a 192k "${1%.*}-optimized.mp4"
  }
fi

